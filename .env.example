# ─────────────────────────────────────────────────────────────────────────────
# healthcare_agent — environment configuration template
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...


# ── Model settings ────────────────────────────────────────────────────────────
# The orchestrator routes queries and synthesises specialist answers.
# A capable model (sonnet or above) is recommended here.
CLAUDE_ORCHESTRATOR_MODEL=claude-sonnet-4-6

# Specialist agents handle domain-specific MCP tool calls.
# Can use a lighter model if latency / cost is a concern.
# Options: claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_SPECIALIST_MODEL=claude-sonnet-4-6

# PA agent drives the full prior-auth workflow (all three MCP servers).
# Keep at sonnet-level or above — it requires multi-step clinical reasoning.
CLAUDE_PA_MODEL=claude-sonnet-4-6

# Max output tokens per agent call.
# Orchestrator synthesises multi-specialist answers — keep this generous.
CLAUDE_MAX_TOKENS=4096


# ── Parallel execution ────────────────────────────────────────────────────────
# Maximum number of specialist agents that can run simultaneously.
# Set to 1 to disable parallelism (serial execution, easier to debug).
# Recommended: match the number of specialist agents (4).
MAX_PARALLEL_AGENTS=4


# ── MCP server probe ──────────────────────────────────────────────────────────
# Timeout in seconds for the HEAD-probe sent to each MCP server at startup.
MCP_PROBE_TIMEOUT=5


# ── Windows console ───────────────────────────────────────────────────────────
# Prevents cp1252 UnicodeEncodeError for box-drawing / emoji characters.
# Set to 1 on Windows; harmless on macOS / Linux.
PYTHONUTF8=1
